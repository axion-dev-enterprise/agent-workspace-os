{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workspace OS Configuration Template",
  "description": "Configuracoes e placeholders a serem preenchidos pelo Agente de IA durante o onboarding inicial.",
  "version": "1.0.0",
  "organization": {
    "name": "{{ORGANIZATION_NAME}}",
    "slug": "{{ORGANIZATION_SLUG}}",
    "primary_domain": "{{PRIMARY_DOMAIN}}"
  },
  "git": {
    "user_name": "{{GIT_USER_NAME}}",
    "user_email": "{{GIT_USER_EMAIL}}",
    "default_branch": "main",
    "org_github_handle": "{{GITHUB_ORG_HANDLE}}"
  },
  "paths": {
    "canonical_root": "{{WORKSPACE_ROOT}}",
    "heavy_builds_and_cache": "{{HEAVY_STORAGE_PATH}}",
    "vault_path": "{{VAULT_PATH}}"
  },
  "deployment": {
    "primary_target": "{{PRIMARY_DEPLOY_TARGET}}",
    "vps_host_ip": "{{VPS_HOST_IP}}",
    "ssh_port": 22
  },
  "agents": {
    "supported_platforms": ["antigravity", "claude", "cursor", "codex", "hermes", "copilot"],
    "cowork_protocol_enabled": true
  }
}
