{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workspace OS Configuration Template",
  "description": "Configuracoes e placeholders a serem preenchidos pelo Agente de IA durante o onboarding inicial.",
  "version": "2.1.0",
  "workspace": {
    "name": "{{WORKSPACE_NAME}}",
    "slug": "{{WORKSPACE_SLUG}}",
    "repository_url": "{{REPOSITORY_URL}}",
    "default_branch": "main"
  },
  "git": {
    "user_name": "{{GIT_USER_NAME}}",
    "user_email": "{{GIT_USER_EMAIL}}",
    "default_branch": "main",
    "remote_owner": "{{REMOTE_OWNER}}"
  },
  "paths": {
    "canonical_root": "{{WORKSPACE_ROOT}}",
    "heavy_builds_and_cache": "{{HEAVY_STORAGE_PATH}}",
    "secrets_reference": "{{SECRETS_REFERENCE}}"
  },
  "deployment": {
    "primary_target": "{{DEPLOYMENT_TARGET}}",
    "requires_explicit_approval": true
  },
  "agents": {
    "supported_platforms": ["{{AGENT_PLATFORM}}"],
    "cowork_protocol_enabled": true
  },
  "optional_connectors": {
    "messaging": {
    "enabled": false,
    "mode": "monitor",
    "port": 4114,
    "authorized_identities": ["{{AUTHORIZED_IDENTITY}}"],
    "inbox_path": "workspace/inbox/messages"
    },
    "cloud_drive": {
    "enabled": false,
    "credentials_reference": "{{CLOUD_DRIVE_CREDENTIALS_REFERENCE}}",
    "target_folder_id": "{{CLOUD_DRIVE_FOLDER_ID}}",
    "sync_interval_minutes": 30
    }
  },
  "privacy": {
    "timeline_directory": "memory/daily_logs",
    "redact_secrets": true,
    "persist_prompt_content": false
  }
}
